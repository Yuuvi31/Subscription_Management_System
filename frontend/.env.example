# LoopBill Frontend Environment Configuration
# Copy this file to .env.local or .env for local development

# Base URL for the Express + Node backend API
VITE_API_URL=http://localhost:5000

# Supabase Project Credentials (safe for browser exposure)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Set to "true" to run with mock data and simulated workflows when backend is offline
# Set to "false" to connect to real backend API and Supabase Auth
VITE_DEMO_MODE=true
