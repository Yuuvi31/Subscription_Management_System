# LoopBill Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in the values below for your Supabase project.
#   3. NEVER commit .env.local to git (it is already gitignored).
#   4. Variables prefixed with VITE_ are exposed to the browser.
#      Never put secret keys inside VITE_ variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API ─────────────────────────────────────────────────────────────
# URL of the Node.js + Express backend (separate project, Render deployment)
VITE_API_URL=http://localhost:5000

# ── Supabase (Frontend / Browser safe) ──────────────────────────────────────
# Your Supabase project URL — found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=your-supabase-url

# Your Supabase anon/publishable key (safe for browser use)
# Found in: Supabase Dashboard → Settings → API → Project API keys → anon (public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── Demo / Offline Mode ──────────────────────────────────────────────────────
# Set to "true" to use localStorage-only mock data when backend API is offline.
# Set to "false" when both the backend API and Supabase are connected.
# Even in demo mode, Supabase Auth works if VITE_SUPABASE_URL is configured.
VITE_DEMO_MODE=true
