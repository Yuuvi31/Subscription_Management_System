# LoopBill Backend Environment Configuration
# Copy this file to .env on the Node.js server. NEVER commit the actual .env file.

PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Transaction Pooler for Prisma)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Direct Database Connection String (Direct Session for Migrations)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase Configuration
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
# KEEP SECRET: Exclusive to trusted backend server
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:5173
